  },
  {
    "data": {
      "text": "The period, 2002-2018 represents a rapid expansion of the city accompanied by expediated socio-economic development that led to significant changes in the city's landscape."
    },
    "annotations": [
      {
        "id": "annotation_7",
        "created_username": "AI_Assistant",
